      value: Magician
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveName
      value: Tower
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[4].objectiveName
      value: The Moon
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[5].objectiveName
      value: Death
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveName
      value: After Cards
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[1].objectiveDialoguesText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[4].objectiveDialoguesText.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[5].objectiveDialoguesText.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: Oh, come in, come in! Welcome, guest from afar. What is it that you
        seek?
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: 'Actions speak better than words. You have a great presence, I can tell.
        I think what you need is a reading from me, little lamb. '
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: The cards hold the past, the present and the future.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[3].dialogueText.text
      value: Go on. Pick the one that speaks to you.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[1].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: Seven of Swords...
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[1].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: Deception, hidden intentions. Someone in this town is lying to everyone.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[1].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: "A man who hides behind faith.  A man who gathers followers\u2026 and
        feeds them lies."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: "Magician. I see\u2026 magic, but not good magic, at least it is not
        used in a good way\u2026 Someone in this town is using this magic to his
        own benefit, someone we used to trust."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: "Apparently this person has something against you, wants to destroy
        you\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: "I saw a witch in my cards before you even walked into this tent and
        lives beyond the forest, in the deep fog, but you can\xB4t reach her yet."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[3].dialogueText.text
      value: A time core. A small mechanical heart that keeps his machines alive.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[4].dialogueText.text
      value: "He promised to bring it to me\u2026 many weeks ago.  But he never leaves
        his tower anymore, it is like if pride has locked him inside his own kingdom."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[5].dialogueText.text
      value: "I need that core to prepare a protection charm for you.  Without it\u2026
        the fog will claim you."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[6].dialogueText.text
      value: "Bring me the time core from the inventor in the clock tower\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[7].dialogueText.text
      value: "\u2026 and I will show you the path to the witch, I want you to survive
        this town, little lamb."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[2].objectiveDialoguesText.Array.data[8].dialogueText.text
      value: To reach the clock tower, you must go through the forest.  Stay in the
        light. Do not listen to voices in the fog. Do not trust them.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: Tower...
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: "Disaster. A place of order that hides corruption. Something or someone
        that beliefs himself untouchable\u2026 but towers always fall."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: "And when they fall, they take others with them\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[3].dialogueText.text
      value: A time core. A small mechanical heart that keeps his machines alive.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[4].dialogueText.text
      value: "He promised to bring it to me\u2026 many weeks ago.  But he never leaves
        his tower anymore, it is like if pride has locked him inside his own kingdom."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[5].dialogueText.text
      value: "I need that core to prepare a protection charm for you.  Without it\u2026
        the fog will claim you."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[6].dialogueText.text
      value: "Bring me the time core from the inventor in the clock tower\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[7].dialogueText.text
      value: "\u2026 and I will show you the path to the witch, I want you to survive
        this town, little lamb."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[3].objectiveDialoguesText.Array.data[8].dialogueText.text
      value: To reach the clock tower, you must go through the forest.  Stay in the
        light. Do not listen to voices in the fog. Do not trust them.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[4].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: The moon.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[4].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: "Illusion\u2026 deception\u2026 nothing in this town is what it seems
        to be."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[4].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: "Something follows you, something that shouldn\u2019t exist. It waits
        in the dark and feeds of fear."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[4].objectiveDialoguesText.Array.data[3].dialogueText.text
      value: "Something follows you, something that shouldn\u2019t exist. It waits
        in the dark and feeds of fear."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[5].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: Death.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[5].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: "Not an end\u2026 but a transformation. Something in you is already
        changing."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[5].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: The longer you stay here, the harder it becomes to remember what you
        were.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[5].objectiveDialoguesText.Array.data[3].dialogueText.text
      value: "Death also means rebirth, you still have a choice\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[0].dialogueText.text
      value: "You are cursed, little lamb.  Not by magic alone\u2026 but by something
        older."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[1].dialogueText.text
      value: "I saw a witch in my cards before you even walked into this tent and
        lives beyond the forest, in the deep fog, but you can\xB4t reach her yet."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[2].dialogueText.text
      value: "I saw a witch in my cards before you even walked into this tent and
        lives beyond the forest, in the deep fog, but you can\xB4t reach her yet."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[3].dialogueText.text
      value: A time core. A small mechanical heart that keeps his machines alive.
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[4].dialogueText.text
      value: "He promised to bring it to me\u2026 many weeks ago.  But he never leaves
        his tower anymore, it is like if pride has locked him inside his own kingdom."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[5].dialogueText.text
      value: "I need that core to prepare a protection charm for you.  Without it\u2026
        the fog will claim you."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[6].dialogueText.text
      value: "Bring me the time core from the inventor in the clock tower\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[7].dialogueText.text
      value: "\u2026 and I will show you the path to the witch, I want you to survive
        this town, little lamb."
      objectReference: {fileID: 0}
    - target: {fileID: 1386405228631038072, guid: 24396a596f7de406f9899f035ad84115, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[6].objectiveDialoguesText.Array.data[8].dialogueText.text
      value: To reach the clock tower, you must go through the forest.  Stay in the
