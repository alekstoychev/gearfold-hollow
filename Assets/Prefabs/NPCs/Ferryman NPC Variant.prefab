    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[1].objectiveDialoguesText.Array.data[0].text
      value: 'Well, that was the ride. Here we are. '
      objectReference: {fileID: 0}
    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: dialogue.objectiveDialogues.Array.data[1].objectiveDialoguesText.Array.data[1].text
      value: "Right. I don\u2019t know if you\u2019ve heard, but the townsfolk really
        enjoys their card games.  have a spare deck with me. Just take them, they
        might come in handy. And just remember: Stay out of the fog. "
      objectReference: {fileID: 0}
