--- !u!114 &2576155007302815467
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4496687567073895488}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69f3f2baa959f4f0888b9ab6a993ad3f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interact.Merchant
  isInteractable: 1
  textPopup: {fileID: 3120704830573924689}
  dialogue:
    speakerName: Merchant
    expression1: {fileID: -8871532131567578648, guid: 8681579eb1cfc6c45bcb311143622265, type: 3}
    expression2: {fileID: -7153642651963740648, guid: 03cd02006b059bf44a0c3ed1217ec12c, type: 3}
    randomDialogue:
    - text: Hiiiiii!!!!
      expression: 0
    - text: Helloo!!!
      expression: 1
    - text: Welcome to town!
      expression: 1
    - text: You got games on yo phone?
      expression: 1
    - text: :D
      expression: 0
    objectiveDialogues:
    - objectiveName: Merchant Introduction
      randomDialogue: []
      objectiveDialoguesText:
      - dialogueText:
          text: "Hey there, buddy! You don\u2019t look like you\u2019re from this
            town. "
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
              m_MethodName: SetActive
              m_Mode: 6
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
      - dialogueText:
          text: "Here for the carnival? I\u2019ve got a lot of stuff you might be
            interested in. "
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: You would need to have something to exchange it for, though.
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: 'But ah, whatcha got there? '
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: "A pretty, shiny thing now, ain\u2019t it? Sorry to say but I don\u2019t
            think that\u2019s working. Not for sale, I assume? Should've guessed."
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: "I don\u2019t think a watch will be of help to you here, no matter
            the sentimental value. What you need is a light. The shadows grow tall
            right outside the main streets."
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: "The night is always deep around here, so you could find it useful.
            As a matter of fact I happen to have a lantern. I could even give it
            to you for free, that\u2019s how nice I am!"
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: "Ah, ah, ah! I said free, not as a gift. I\u2019ll make you an offer,
            right? Let\u2019s play a game of cards and if you win, I give you the
            lantern."
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: "You ain\u2019t played before? Blimey, you\u2019re in for a ride!
            Eh, don\u2019t look so worried. I wouldn\u2019t scam a newcomer, not
            you anyways!"
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: If you win, I have to give you a card. But if you lose, you give
            me a card from your deck. How does that sound, eh?
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Systems.CustomSceneManager, Assembly-CSharp
              m_MethodName: LoadScene
              m_Mode: 5
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: CardsGameTest
                m_BoolArgument: 0
              m_CallState: 2
    - objectiveName: Merchant Win Cards
      randomDialogue: []
      objectiveDialoguesText:
      - dialogueText:
          text: "Ooh, well done. You ain\u2019t as sloppy with your cards as you
            look. "
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
              m_MethodName: SetActive
              m_Mode: 6
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
      - dialogueText:
          text: "I\u2019m not a sore loser, so here. As the deal goes."
          expression: 0
        completeObjectiveAfterText: 1
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Interact.Interactable, Assembly-CSharp
              m_MethodName: SetObjectiveIndex
              m_Mode: 3
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 3
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Interact.Interactable, Assembly-CSharp
              m_MethodName: Interact
              m_Mode: 1
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Player.PlayerController, Assembly-CSharp
              m_MethodName: Lantern
              m_Mode: 1
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
    - objectiveName: Merchant Lose Cards
      randomDialogue: []
      objectiveDialoguesText:
      - dialogueText:
          text: "Oh, too bad! Don\u2019t be too bummed out about it, I\u2019m a tough
            opponent to beat. "
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
              m_MethodName: SetActive
              m_Mode: 6
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
      - dialogueText:
          text: "But hey, here\u2019s the lantern, I\u2019m a man of my word.  "
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Player.PlayerController, Assembly-CSharp
              m_MethodName: Lantern
              m_Mode: 1
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
      - dialogueText:
          text: "You\u2019d better learn how to play cards if you wanna get anywhere
            in this town, though."
          expression: 0
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Interact.Interactable, Assembly-CSharp
              m_MethodName: ProgressDialogueObjective
              m_Mode: 1
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Interact.Interactable, Assembly-CSharp
              m_MethodName: Interact
              m_Mode: 1
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
    - objectiveName: Merchant After Cards
      randomDialogue: []
      objectiveDialoguesText:
      - dialogueText:
          text: "Now go have fun lad! The carnival is thriving, there\u2019s a lot
            of fun to be had and the night is still young. "
          expression: 1
        completeObjectiveAfterText: 0
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls: []
      - dialogueText:
          text: And if you need to purchase anything, you know where to find me.
          expression: 0
        completeObjectiveAfterText: 1
        onDialogueContinue:
          m_PersistentCalls:
            m_Calls:
            - m_Target: {fileID: 0}
              m_TargetAssemblyTypeName: Interact.Interactable, Assembly-CSharp
              m_MethodName: ProgressDialogueObjective
              m_Mode: 1
              m_Arguments:
                m_ObjectArgument: {fileID: 0}
                m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
                m_IntArgument: 0
                m_FloatArgument: 0
                m_StringArgument: 
                m_BoolArgument: 0
              m_CallState: 2
    currentObjectiveIdx: 0
  playerWinDialogueIndex: -1
  playerLossDialogueIndex: -1
