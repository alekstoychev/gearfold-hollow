    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: 'dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[0]'
      value: "It\u2019s a nice night. The sky\u2019s clear, though the fog is starting
        to settle down here."
      objectReference: {fileID: 0}
    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: 'dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[1]'
      value: 'What brings you to (town name) anyway? '
      objectReference: {fileID: 0}
    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: 'dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[2]'
      value: Not the talkative type, huh?
      objectReference: {fileID: 0}
    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: 'dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[3]'
      value: "The whole town\u2019s pretty lively right now. Are you here for the
        carnival? Well, I hope you enjoy your time if that\u2019s the case. Though
        I must give fair warning: I\u2019ve heard about things happening here through
        word of mouth, so be careful out there. Stay where there\u2019s people, in
        the light.  "
      objectReference: {fileID: 0}
    - target: {fileID: 2404020166708346828, guid: 198ba50c2a2834d6f9dca91c491f95f3, type: 3}
      propertyPath: 'dialogue.objectiveDialogues.Array.data[0].objectiveDialoguesText.Array.data[4]'
